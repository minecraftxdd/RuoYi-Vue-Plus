<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.dromara.photo.mapper.FacePhotoMapper">

    <resultMap type="org.dromara.photo.domain.vo.FacePhotoEncodeLogVo" id="FacePhotoEncodeLogVoResult">
        <result property="id" column="id"/>
        <result property="photoId" column="photo_id"/>
        <result property="encodeType" column="encode_type"/>
        <result property="encodingData" column="encoding_data"/>
        <result property="encodingDataLength" column="encoding_data_length"/>
        <result property="faceIndex" column="face_index"/>
        <result property="status" column="status"/>
        <result property="errorMsg" column="error_msg"/>
        <result property="operatorId" column="operator_id"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <!-- 查询编码日志列表 -->
    <select id="selectEncodeLogList" resultMap="FacePhotoEncodeLogVoResult">
        SELECT
            id,
            photo_id,
            encode_type,
            encoding_data,
            LENGTH(encoding_data) AS encoding_data_length,
            face_index,
            status,
            error_msg,
            operator_id,
            create_time
        FROM face_photo_encode_log
        <where>
            <if test="photoId != null">
                AND photo_id = #{photoId}
            </if>
        </where>
        ORDER BY create_time DESC
    </select>

</mapper>
